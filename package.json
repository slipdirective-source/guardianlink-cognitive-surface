{
  "name": "guardianlink-cognitive-surface",
  "version": "0.1.0",
  "description": "Human-facing cognitive surface for GuardianLink",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "build:ui": "esbuild ui/src/main.ts --bundle --format=iife --platform=browser --outfile=ui/dist/bundle.js",
    "serve:ui": "node ui/serve.js",
    "smoke:ui": "node scripts/smoke-ui.js",
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "esbuild": "^0.28.2",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^30.1.3",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "projects": [
      {
        "displayName": "pipeline",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "roots": [
          "<rootDir>/src"
        ]
      },
      {
        "displayName": "ui",
        "preset": "ts-jest",
        "testEnvironment": "jsdom",
        "roots": [
          "<rootDir>/ui/src"
        ],
        "transform": {
          "^.+\\.tsx?$": [
            "ts-jest",
            {
              "tsconfig": "tsconfig.ui.json"
            }
          ]
        }
      }
    ]
  }
}
